# Personal settings for mts-link-sync.
# Copy this file to `.env` and edit. `.env` is gitignored — nothing personal is committed.

# REQUIRED. Where exported chat markdown, the registry and the cursor live.
# This has no default on purpose: the predecessor tool defaulted to a local folder,
# and when this setting went missing it silently read an empty registry from the
# wrong place while still exiting 0. Point it at the vault's chat intake folder.
MTS_LINK_OUTPUT_DIR=/absolute/path/to/GROUND/_intake/chats

# Registry of watched chats. Default: <OUTPUT_DIR>/watched-chats.yaml
# MTS_LINK_REGISTRY=/absolute/path/to/GROUND/_intake/chats/watched-chats.yaml

# Delta cursor (per-chat watermark). Default: <OUTPUT_DIR>/.sync-cursor.json
# MTS_LINK_CURSOR=/absolute/path/to/GROUND/_intake/chats/.sync-cursor.json

# Saved browser session created by `npm run login`. Personal SSO secret — keep it
# outside any git repo. Default: ~/.mts-link-chat-sync/auth.json
# MTS_LINK_AUTH_FILE=~/.mts-link-chat-sync/auth.json

# Where Playwright browsers live. Set this when the system cache
# (~/Library/Caches/ms-playwright) is unwritable or gets cleaned:
#   PLAYWRIGHT_BROWSERS_PATH=$PWD/.browsers npx playwright install chromium
# PLAYWRIGHT_BROWSERS_PATH=/absolute/path/to/tools/mts-link-sync/.browsers

# Which .env file to read. Default: `.env` next to the tool. Real environment
# variables always win over file values.
# MTS_LINK_ENV_FILE=/absolute/path/to/another.env

# Chats web app entry point / login URL. Override only for a different MTS Link instance.
# MTS_LINK_CHATS_URL=https://my.mts-link.ru/chats/
# MTS_LINK_LOGIN_URL=https://my.mts-link.ru/
